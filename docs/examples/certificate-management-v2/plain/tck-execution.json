    {
      "id": "catalog-policy-validation",
      "metadata": {
        "name": "Catalog Policy Validation",
        "version": "v1.0.0",
        "description": "Validate CX-0135 catalog requirements: exactly one CCMAPI asset per BPNL and mandatory usage policy constraints (UsagePurpose: cx.ccm.base:1, FrameworkAgreement: DataExchangeGovernance:1.0).\n"
      },
      "symbol_table": {
        "steps.pull_ccmapi_endpoint.edr_token": {
          "source": "step_output",
          "produced_by": 0,
          "type": "string",
          "class": "AuthToken"
        },
        "steps.pull_ccmapi_endpoint.dataplane_url": {
          "source": "step_output",
          "produced_by": 0,
          "type": "string"
        }
      },
      "instructions": [
        {
          "index": 0,
          "id": "pull_ccmapi_endpoint",
          "uses": "connector/consumer/pull_data_filtered",
          "name": "Query catalog for CCMAPI assets and obtain dataplane credentials",
          "with": {
            "counter_party_address": {
              "$ref": "env.sut_counter_party_address.value"
            },
            "counter_party_id": {
              "$ref": "env.sut_counter_party_id.value"
            },
            "policy": {
              "$ref": "env.ccm_usage_policy.policy"
            },
            "filters": [
              {
                "operand_left": "https://w3id.org/edc/v0.0.1/ns/type",
                "operator": "=",
                "operand_right": "https://w3id.org/catenax/taxonomy#CCMAPI"
              },
              {
                "operand_left": "http://purl.org/dc/terms/subject",
                "operator": "=",
                "operand_right": "https://w3id.org/catenax/taxonomy#CompanyCertificateManagementNotificationApi"
              },
              {
                "operand_left": "https://w3id.org/catenax/ontology/common#version",
                "operator": "=",
                "operand_right": "3.0"
              }
            ]
          },
          "returns": {
            "edr_token": {
              "type": "string",
              "class": "AuthToken"
            },
            "dataplane_url": {
              "type": "string"
            }
          },
          "validate": [
            {
              "uses": "validate/assert",
              "with": {
                "input": "edr_token",
                "operator": "not_null"
              }
            },
            {
              "uses": "validate/assert",
              "with": {
                "input": "dataplane_url",
                "operator": "not_null"
              }
            }
          ],
          "phase": "main",
          "phase_index": 0
        }
      ]
    },
